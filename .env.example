# =========================================================================
# EDKART ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =========================================================================
# Instructions: Copy this file to '.env' and populate actual credentials.
# Do NOT commit the '.env' file containing real secrets to version control.

# -------------------------------------------------------------------------
# SPRING APP CONFIGURATION
# -------------------------------------------------------------------------
# Active profile (dev / prod / test)
SPRING_PROFILES_ACTIVE=prod
# Exposed port binding on the host machine
SERVER_PORT_BINDING=8080
# Application Timezone
APP_TIMEZONE=UTC

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL)
# -------------------------------------------------------------------------
# MySQL Root Password (used to initialize container)
DB_ROOT_PASSWORD=ChangeThisToStrongRootPassword123!
# Name of the MySQL database
DB_NAME=edkart
# MySQL database application user
DB_USERNAME=edkart_app_user
# Password for the MySQL database application user
DB_PASSWORD=ChangeThisToStrongAppPassword456$
# DB Port bound on the host machine
DB_PORT_BINDING=3306

# -------------------------------------------------------------------------
# PHPMYADMIN CONFIGURATION
# -------------------------------------------------------------------------
# Port to access phpMyAdmin in your browser
PMA_PORT_BINDING=8081

# -------------------------------------------------------------------------
# SECURITY CONFIGURATION (CORS & JWT)
# -------------------------------------------------------------------------
# CORS allowed domains (comma-separated, e.g. http://localhost:3000,https://edkart.com)
CORS_ALLOWED_ORIGINS=*
# Base64-encoded HS256 JWT signing secret (Must be at least 256 bits for security)
JWT_SECRET=9a4f2c5e7b8a1c3d9e0f2a4b6c8d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d
# JWT expiration duration in milliseconds (e.g., 86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# -------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# -------------------------------------------------------------------------
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=your_smtp_password_here

# -------------------------------------------------------------------------
# AWS S3 CREDENTIALS (for product images cloud storage)
# -------------------------------------------------------------------------
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=edkart-uploads-bucket

# -------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (optional alternative CDN storage)
# -------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
